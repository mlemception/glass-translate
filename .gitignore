.venv/
__pycache__/
*.pyc
models/*/
models/*.argosmodel
demo/output/
.pytest_cache/
*.egg-info/
# build outputs (docs/GLASS_DESIGN.md section 4 / 6)
dist/
build/
packaging/glasstranslate.ico
packaging/version_info.txt
# generated by tools/build_resources.py; committed once by the integration owner
glasstranslate/ui/resources_rc.py

# Local credentials for live checks (never committed)
Secret/
renderer/.venv/
# portable-mode marker (docs/plans/2026-09-11-portable-bundle.md): only ever written by build_portable.py
# into the bundle; a copy next to run.py switches a checkout to portable paths and must stay local.
# Anchored to the repo root: glasstranslate/config/ is a source package and must never match.
/portable.txt
/config/
/logs/
# Local corpus of third-party volumes used to eyeball the typesetter (~16 GB of
# .cbz/.rar).  Anchored to the repo root; never committed.
/JA vs. EN/
# Ground truth and OCR caches derived from those licensed pages.
# typeset_reference.derive() writes eng_aligned.png - a full warped copy of the reference
# page - under demo/reference/<stem>/, and the corpus harness would otherwise stage
# thousands of them.  Anchored to the repo root.
/demo/reference/
/demo/cache/

# Local working notes, like the other process docs in this repo. Never shipped.
/docs/MANUAL_PROPOSALS.md

# Dev-only side-products of tools/profile_glass.py: they carry absolute paths and the monitor name.
*.summary.json
*.qt-stderr.log

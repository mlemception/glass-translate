  <qresource prefix="/fonts">
    <file alias="animeace2_ital.ttf">../render/fonts/animeace/animeace2_ital.ttf</file>
    <file alias="animeace2_reg.ttf">../render/fonts/animeace/animeace2_reg.ttf</file>
  </qresource>
  <qresource prefix="/icons">
    <file alias="app.png">icons/app.png</file>
  </qresource>
</RCC>
